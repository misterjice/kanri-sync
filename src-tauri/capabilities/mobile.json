{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "description": "Capability for the main window on Android",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "permissions": [
    "core:default",
    "core:image:default",
    "core:window:default",
    "store:default",
    "dialog:allow-open",
    "dialog:default",
    "log:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://kanriapp.com/*"
        },
        {
          "url": "https://github.com/kanriapp/*"
        },
        {
          "url": "https://discord.gg/AVqHrvxB9C"
        }
      ]
    },
    "barcode-scanner:default"
  ]
}
